# OpenAI API Key
# Get your API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=your-api-key-here
OPENAI_MODEL=gpt-4o
# Optional: OpenAI-compatible base URL (vLLM/litellm/self-hosted/etc.)
# Example: http://localhost:8000/v1
# OPENAI_BASE_URL=

# Ollama Configuration (use local models instead of OpenAI)
# Set USE_OLLAMA=true to use Ollama instead of OpenAI
USE_OLLAMA=true
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=gpt-oss:20b

# Local dev / testing
# Use a deterministic, no-network mock LLM (useful for demos and automated tests)
# USE_MOCK_LLM=true

# Local Speech Services (STT & TTS)
# Set USE_LOCAL_WHISPER=true to use local Whisper instead of OpenAI
USE_LOCAL_WHISPER=true
WHISPER_URL=http://localhost:9000
TTS_URL=http://localhost:9001

# Auth (authme) - local dev without Caddy/Authelia
# Set DEV_USER (and optionally DEV_EMAIL, DEV_NAME, DEV_GROUPS) to simulate a logged-in user
# DEV_USER=devuser
# DEV_EMAIL=dev@example.com
# DEV_NAME=Dev User
